# Optional: only needed when activating the real Salesforce adapter.
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
CRM_TOKEN_URL=https://login.salesforce.com/services/oauth2/token
CRM_API_VERSION=v61.0
CRM_PRODUCT_OBJECT=Portfolio_Product__c
CRM_PRODUCT_EXTERNAL_ID_FIELD=External_Id__c
CRM_CUSTOMER_OBJECT=Portfolio_Customer__c
CRM_CUSTOMER_EXTERNAL_ID_FIELD=External_Id__c
CRM_ORDER_OBJECT=Portfolio_Order__c
CRM_ORDER_EXTERNAL_ID_FIELD=External_Id__c
CRM_DELIVERY_OBJECT=Portfolio_Delivery__c
CRM_DELIVERY_EXTERNAL_ID_FIELD=External_Id__c

# Optional external ERP database. The default project uses in-memory H2.
DB_DRIVER=org.h2.Driver
DB_URL=jdbc:h2:mem:erp_portfolio;MODE=MSSQLServer;DB_CLOSE_DELAY=-1;DATABASE_TO_UPPER=false
DB_USERNAME=sa
DB_PASSWORD=
